DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jot_transportation?schema=public"
JWT_SECRET="generate-a-long-random-string-for-production"
PORT=3000
CORS_ORIGIN="*"
# Web + iOS + Android OAuth client IDs (comma-separated). Web must match VITE_GOOGLE_CLIENT_ID.
# Example: GOOGLE_CLIENT_ID="123-web.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-android.apps.googleusercontent.com"
GOOGLE_CLIENT_ID=""
# Optional: Web OAuth client ID for mobile code exchange (defaults to first value in GOOGLE_CLIENT_ID).
# GOOGLE_WEB_CLIENT_ID=""
# Required for mobile Google sign-in (Expo Go). Google Cloud → Web client → Client secret.
GOOGLE_CLIENT_SECRET=""
# SMTP / Contact form
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="JO Transportation"
SMTP_FROM_EMAIL=""
CONTACT_COMPANY_EMAIL=""
COMPANY_ADDRESS="Dallas - Fort Worth, Texas, USA"
# HTTP request logs: dev | combined | tiny | short (see morgan). Default: dev in development, combined in production.
# HTTP_LOG_FORMAT=dev
