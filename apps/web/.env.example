# Local: http://localhost:3000
# Production (also set in .env.production / Vercel): https://jotransipotation.online
VITE_API_BASE_URL="http://localhost:3000"
# Public site URL used for canonical links, Open Graph, and sitemap generation.
# Example: https://jotransportation.xyz
VITE_SITE_URL=""
# Same Web client ID as API GOOGLE_CLIENT_ID (first value if comma-separated).
VITE_GOOGLE_CLIENT_ID=""
# Google Cloud Console → Credentials → Web client → Authorized JavaScript origins:
# http://localhost:5173 and your production URL.
VITE_MAPBOX_ACCESS_TOKEN=""
